# Copy to .env and fill in. Never commit .env.
# Phase 0 rule 3: everything through environment variables, no hardcoded URLs.

# ---- Environment -----------------------------------------------------------
ENV=local                 # local | ci | staging | production
DEBUG=true

# ---- Database --------------------------------------------------------------
# Plain PostgreSQL. Swap this one string to move between Docker, Neon and an
# on-prem server — nothing else changes.
DATABASE_URL=postgresql+psycopg://greenlam:greenlam@localhost:5432/greenlam

# ---- Auth ------------------------------------------------------------------
# Generate real values:  openssl rand -base64 48
JWT_SECRET=dev-only-change-me

# Peppers the 6-digit PIN before hashing, so a stolen database cannot be
# cracked offline. WARNING: changing this invalidates every existing PIN and
# every user has to be re-issued one. Treat it as permanent.
PIN_PEPPER=dev-only-change-me

ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30     # long window is required for offline operation

# ---- PIN lockout (graduated, supervisor unlock) ----------------------------
PIN_BACKOFF_AFTER=3          # free attempts before the delay starts
PIN_BACKOFF_BASE_SECONDS=1   # doubles per failure past that
PIN_BACKOFF_CAP_SECONDS=300
PIN_HARD_LOCK_AFTER=10       # supervisor must unlock in-app

# ---- Web -------------------------------------------------------------------
# Empty in the same-origin deployment: the PWA and /api/* share one host, so
# there is no cross-origin request to allow. Fill in only for a split dev setup.
CORS_ORIGINS=
COOKIE_SECURE=false       # true in production; false on http://localhost
COOKIE_DOMAIN=
BASE_URL=http://localhost:5173   # QR labels encode {BASE_URL}/s/{qr_token}

# ---- Seed guard ------------------------------------------------------------
# The seed refuses to run against a non-local database unless this is true.
# Leave it false until plant IT approves external hosting in writing.
ALLOW_REMOTE_SEED=false

# ---- Tests -----------------------------------------------------------------
TEST_DATABASE_URL=postgresql+psycopg://greenlam:greenlam@localhost:5432/greenlam_test
